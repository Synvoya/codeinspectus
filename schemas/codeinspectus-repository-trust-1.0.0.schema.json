{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeinspectus.com/schemas/v1.0.0/repository-trust.schema.json",
  "title": "CodeInspectus repository trust document",
  "type": "object",
  "required": ["schema_version", "coverage", "summary", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "coverage": {
      "type": "object",
      "required": ["state", "capabilities", "limitations"],
      "properties": {
        "state": { "$ref": "#/$defs/coverageState" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityCoverage" }
        },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "summary": { "$ref": "#/$defs/summary" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "enum": [
        "source_integrity",
        "explicit_ai_attribution",
        "content_provenance",
        "statistical_watermark"
      ]
    },
    "coverageState": {
      "enum": ["ran", "partial", "not_run", "not_applicable", "unavailable"]
    },
    "capabilityCoverage": {
      "type": "object",
      "required": ["capability", "state", "validators", "limitations"],
      "properties": {
        "capability": { "$ref": "#/$defs/capability" },
        "state": { "$ref": "#/$defs/coverageState" },
        "validators": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["verified", "probable", "informational", "not_verifiable", "total"],
      "properties": {
        "verified": { "type": "integer", "minimum": 0 },
        "probable": { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 },
        "not_verifiable": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 },
        "field": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["start_line", "end_line"] },
        { "required": ["field"] }
      ],
      "dependentRequired": {
        "start_line": ["end_line"],
        "end_line": ["start_line"],
        "start_column": ["end_column", "start_line", "end_line"],
        "end_column": ["start_column", "start_line", "end_line"]
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["summary", "attributes"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number", "boolean"] },
              "redacted": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validator": {
      "type": "object",
      "required": ["id", "method", "authoritative", "independently_verifiable", "egress"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "method": { "enum": ["deterministic", "declarative", "statistical"] },
        "authoritative": { "type": "boolean" },
        "independently_verifiable": { "type": "boolean" },
        "egress": { "enum": ["none", "optional", "required"] }
      },
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "required": ["eligible", "requires_approval", "reversible", "protected_record", "reason"],
      "properties": {
        "eligible": { "type": "boolean" },
        "requires_approval": { "const": true },
        "reversible": { "type": "boolean" },
        "protected_record": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "eligible": { "const": true } } },
          "then": { "properties": { "reversible": { "const": true }, "protected_record": { "const": false } } }
        }
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "fingerprint",
        "kind",
        "state",
        "marker_class",
        "location",
        "evidence",
        "validator",
        "confidence",
        "limitations",
        "remediation"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9._:-]{0,127}$" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "$ref": "#/$defs/capability" },
        "state": { "enum": ["verified", "probable", "informational", "not_verifiable"] },
        "marker_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "location": { "$ref": "#/$defs/location" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "validator": { "$ref": "#/$defs/validator" },
        "confidence": { "enum": ["high", "medium", "low", "none"] },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "remediation": { "$ref": "#/$defs/remediation" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "verified" } } },
          "then": {
            "properties": {
              "confidence": { "const": "high" },
              "validator": { "properties": { "independently_verifiable": { "const": true } } }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "not_verifiable" } } },
          "then": {
            "properties": {
              "confidence": { "const": "none" },
              "remediation": { "properties": { "eligible": { "const": false } } }
            }
          }
        },
        {
          "if": { "properties": { "remediation": { "properties": { "eligible": { "const": true } } } } },
          "then": { "properties": { "state": { "const": "verified" } } }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "statistical_watermark" },
              "state": { "const": "verified" }
            },
            "required": ["kind", "state"]
          },
          "then": {
            "properties": {
              "validator": {
                "properties": {
                  "authoritative": { "const": true },
                  "independently_verifiable": { "const": true }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
