{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeinspectus.com/schemas/bulk/1.0.0/manifest.schema.json",
  "title": "CodeInspectus bounded bulk-scan manifest",
  "type": "object",
  "required": ["$schema", "schema_version", "run_id", "parent", "created_at", "updated_at", "configuration", "discovery", "repositories", "aggregate"],
  "properties": {
    "$schema": { "const": "https://codeinspectus.com/schemas/bulk/1.0.0/manifest.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^bulk-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "parent": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "configuration": {
      "type": "object",
      "required": ["concurrency", "max_repositories", "max_attempts", "max_findings", "include_compliance"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_repositories": { "type": "integer", "minimum": 1, "maximum": 500 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "scanners": { "type": "array", "items": { "enum": ["sast", "secret", "vuln", "misconfig", "license", "ai"] }, "uniqueItems": true },
        "max_findings": { "type": "integer", "minimum": 1 },
        "include_compliance": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["entry_limit", "candidate_entries", "repositories_found", "repositories_selected", "repositories_omitted", "partial", "limitations"],
      "properties": {
        "entry_limit": { "type": "integer", "minimum": 1 },
        "candidate_entries": { "type": "integer", "minimum": 0 },
        "repositories_found": { "type": "integer", "minimum": 0 },
        "repositories_selected": { "type": "integer", "minimum": 0, "maximum": 500 },
        "repositories_omitted": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "repositories": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/repository" } },
    "aggregate": {
      "type": "object",
      "required": ["coverage", "total", "pending", "running", "complete", "partial", "unknown", "failed", "cancelled", "finding_count"],
      "properties": {
        "coverage": { "enum": ["complete", "partial", "unknown"] },
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "running": { "type": "integer", "minimum": 0 },
        "complete": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["repository", "relative_path", "state", "attempts"],
      "properties": {
        "repository": { "type": "string" },
        "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$" },
        "state": { "enum": ["pending", "running", "complete", "partial", "unknown", "failed", "cancelled"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "scan_id": { "type": "string", "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "aggregate_coverage": { "enum": ["complete", "partial", "unknown"] },
        "finding_count": { "type": "integer", "minimum": 0 },
        "highest_severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
