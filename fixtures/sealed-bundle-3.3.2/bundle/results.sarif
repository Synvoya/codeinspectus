{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeInspectus",
          "version": "3.3.2",
          "informationUri": "https://codeinspectus.com",
          "rules": [
            {
              "id": "ci-ai-client-hardcoded-secret",
              "name": "Hard-coded secret in client-reachable code",
              "shortDescription": {
                "text": "Hard-coded secret in client-reachable code"
              },
              "help": {
                "text": "Remove the hard-coded credential; load it from a server-side secret store and rotate the exposed value."
              },
              "properties": {
                "severity": "critical",
                "confidence": "high",
                "cwe": [
                  "CWE-798",
                  "CWE-312"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "ai:client-secrets",
                  "codeinspectus-ai:invocation",
                  "codeinspectus:pipeline",
                  "gitleaks:binary",
                  "gitleaks:config",
                  "gitleaks:effective-ignore",
                  "gitleaks:invocation"
                ]
              }
            },
            {
              "id": "ci-ai-llm-tool-argument-command-execution",
              "name": "Model-produced tool argument reaches shell execution",
              "shortDescription": {
                "text": "Model-produced tool argument reaches shell execution"
              },
              "help": {
                "text": "Treat model tool arguments as untrusted: validate against a strict schema and server-owned allowlist, require approval for sensitive actions, and avoid shell command strings."
              },
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "cwe": [
                  "CWE-78",
                  "CWE-1426"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "codeinspectus:pipeline",
                  "codeinspectus-ai:invocation",
                  "ai:unsafe-tool-execution"
                ]
              }
            },
            {
              "id": "ci-ai-prompt-injection-sink",
              "name": "Potential prompt-injection sink with tool/function-calling access",
              "shortDescription": {
                "text": "Potential prompt-injection sink with tool/function-calling access"
              },
              "help": {
                "text": "Keep untrusted content as data in a separate user-role message, never concatenated into the system prompt; validate it first; and gate any tool actions."
              },
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "cwe": [
                  "CWE-1427"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "codeinspectus:pipeline",
                  "codeinspectus-ai:invocation",
                  "ai:prompt-injection"
                ]
              }
            },
            {
              "id": "ci-ai-public-env-secret",
              "name": "Secret exposed via client-visible env prefix",
              "shortDescription": {
                "text": "Secret exposed via client-visible env prefix"
              },
              "help": {
                "text": "Rename to a server-only env var (no public prefix) and read it only in server code; rotate if it ever shipped."
              },
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "cwe": [
                  "CWE-798",
                  "CWE-312"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "codeinspectus:pipeline",
                  "codeinspectus-ai:invocation",
                  "ai:client-secrets"
                ]
              }
            },
            {
              "id": "ci-ai-rls-missing",
              "name": "Repository-defined public table 'payments' lacks Row Level Security",
              "shortDescription": {
                "text": "Repository-defined public table 'payments' lacks Row Level Security"
              },
              "help": {
                "text": "Enable RLS on public.payments, add least-privilege policies, and verify deployed grants separately."
              },
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "cwe": [
                  "CWE-862",
                  "CWE-285"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "codeinspectus:pipeline",
                  "codeinspectus-ai:invocation",
                  "ai:supabase-rls-policy-state"
                ]
              }
            },
            {
              "id": "ci-ai-rls-using-true",
              "name": "RLS permits SELECT on sensitive table 'profiles' for anonymous and authenticated clients",
              "shortDescription": {
                "text": "RLS permits SELECT on sensitive table 'profiles' for anonymous and authenticated clients"
              },
              "help": {
                "text": "Replace the open policy composition with operation-specific ownership or authorization predicates unless this access is deliberate."
              },
              "properties": {
                "severity": "critical",
                "confidence": "high",
                "cwe": [
                  "CWE-863",
                  "CWE-285"
                ],
                "producer": "codeinspectus-ai",
                "producer_components": [
                  "codeinspectus:pipeline",
                  "codeinspectus-ai:invocation",
                  "ai:supabase-rls-policy-state"
                ]
              }
            }
          ]
        }
